SOCKET_PORT=socket-server-port
SPRING_PROFILES_ACTIVE=your-application-profile

# Database
DB_NAME=db_name
DB_URL=db_url
DB_USERNAME=db_username
DB_PASSWORD=db_password
DB_ROOT_PASSWORD=db_root_password

# Security
JWT_SECRET=replace-with-generated-secret
JWT_EXPIRATION=access-token-expiration-time(default: 900000)
JWT_REFRESH_EXPIRATION=refresh-token-expiration-time(default: 2592000000)
TLS_KEYSTORE_PASSWORD=your-tls-keystore-password

# File system
IMAGE_DIR=path/to/image/directory
TLS_KEYSTORE_PATH=path/to/keystore/directory